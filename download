#!/usr/bin/env python3
"""Model and Resource Downloader for the AI Knowledge Engine.

Pre-downloads embedding models from HuggingFace, initializes storage/data
directories, and verifies Ollama LLM availability for offline or quick-start usage.
"""

# ==============================================================================
# 1. IMPORTS & RUNTIME VERIFICATION
# ==============================================================================

import os
import sys
import shutil
import subprocess
from config import LLM_MODEL


# ==============================================================================
# 2. DIRECTORY STRUCTURE INITIALIZATION
# ==============================================================================

def initialize_directories() -> None:
    """Creates the required data and storage directories if they do not exist."""
    print("\n[1/3] Initializing local directories...")
    for directory in ["data", "storage"]:
        os.makedirs(directory, exist_ok=True)
        print(f"  [OK] Directory verified: ./{directory}")


# ==============================================================================
# 3. SENTENCE TRANSFORMER EMBEDDING MODEL DOWNLOAD
# ==============================================================================

def download_embedding_model(model_name: str = "all-MiniLM-L6-v2") -> bool:
    """Pre-downloads and caches the SentenceTransformer model weights.

    Args:
        model_name: HuggingFace model repository identifier.

    Returns:
        True if the download succeeded, False otherwise.
    """
    print(f"\n[2/3] Downloading embedding model '{model_name}'...")
    try:
        from sentence_transformers import SentenceTransformer

        print("  Downloading weights from HuggingFace Hub (cached locally)...")
        _ = SentenceTransformer(model_name)
        print(f"  [OK] Successfully downloaded and cached '{model_name}'.")
        return True
    except ImportError:
        print("  [WARN] 'sentence-transformers' is not installed in the active environment.")
        print("         Install via: pip install -r requirements.txt")
        return False
    except Exception as exc:
        print(f"  [FAIL] Failed to download embedding model: {exc}")
        return False


# ==============================================================================
# 4. OLLAMA LLM MODEL PRE-FLIGHT & DOWNLOAD
# ==============================================================================

def pull_ollama_model(model_name: str = LLM_MODEL) -> bool:
    """Pulls the specified LLM model using the local Ollama CLI.

    Args:
        model_name: Model tag for Ollama.

    Returns:
        True if the pull succeeded, False otherwise.
    """
    print(f"\n[3/3] Checking Ollama LLM model '{model_name}'...")

    ollama_path = shutil.which("ollama")
    if not ollama_path:
        print("  [WARN] 'ollama' binary was not found in system PATH.")
        print("         Download and install Ollama from: https://ollama.com")
        return False

    try:
        print(f"  Running: ollama pull {model_name}...")
        result = subprocess.run(
            ["ollama", "pull", model_name],
            check=True,
            capture_output=True,
            text=True,
        )
        print(f"  [OK] Successfully verified and pulled '{model_name}'.")
        return True
    except subprocess.CalledProcessError as err:
        print(f"  [FAIL] Error pulling Ollama model '{model_name}': {err.stderr.strip()}")
        return False
    except Exception as exc:
        print(f"  [FAIL] Unexpected error running ollama: {exc}")
        return False


# ==============================================================================
# 5. MAIN EXECUTION PIPELINE
# ==============================================================================

def main() -> None:
    """Runs the complete setup and download sequence."""
    print("=" * 60)
    print("AI Knowledge Engine - Setup & Resource Downloader")
    print("=" * 60)

    initialize_directories()
    download_embedding_model()
    pull_ollama_model()

    print("\n" + "=" * 60)
    print("Setup check complete! You can now run: python main.py")
    print("=" * 60 + "\n")


if __name__ == "__main__":
    main()
